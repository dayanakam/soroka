# Токен от @BotFather
BOT_TOKEN=123456:AA...

# Публичный HTTPS-адрес, по которому открывается мини-апп.
# Локально — адрес туннеля (cloudflared/ngrok), в проде — домен хостинга.
PUBLIC_URL=https://example.com

# Порт веб-сервера (хостинг обычно подставляет свой)
PORT=8080

# Куда писать базу
DB_PATH=data/outfits.db

# Часовой пояс для расписания рассылки
TZ=Europe/Moscow

# Ключ Pexels: нужен только чтобы скачать обложки стилей (fetch_covers.py)
PEXELS_API_KEY=
